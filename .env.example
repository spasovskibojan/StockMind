# Copy this file to .env and fill in real values
# .env should NEVER be committed to git

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (used by both Django and the db container) ---
POSTGRES_DB=stockmind
POSTGRES_USER=stockmind
POSTGRES_PASSWORD=stockmind_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM providers (get free keys at: console.groq.com, aistudio.google.com) ---
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Frontend (Vite reads VITE_* prefixed vars) ---
VITE_API_BASE_URL=http://localhost:8000/api
